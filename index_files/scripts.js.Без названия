	function select_city(selected_city) {
		$.ajax({
			url:     '/local/geo.php?set_checked_city=1&by_city=' + selected_city,
			type: 'post',
			dataType: "json",
			success: function(html){
				//$('#city_modal').css({'opacity':'.3'});
				$('#city_modal .input').val(selected_city + " (идет запрос условий доставки, ожидайте...)");
				$('header .city .current_btn span').text(selected_city);
				$('header .city .current span > b').text(selected_city);
				if ($('.product_info').length) {
					$.ajax({
						url:     '/local/get_pecom_cities.php?city=' + selected_city,
						type: 'post',
						success: function(response) {	
							if (response) {
								if(response != '-1') {
									if (selected_city == "Москва") {
										$('#msk_self').show();
									} else {
										$('#msk_self').hide();
									}								
									$('#city_modal .input').val(selected_city);
									$('.product_info .delivery .city button').text(selected_city);
									$('.product_info .delivery .total_delivery_price').text(response);
									$('.product_info .delivery').show();
								}
								$.fancybox.close();
							}
						}
					});
				} else {
					$.fancybox.close();
				}
			}
		});
	}
	
