function productCatHeight(context, step) {
	let start = 0,
		finish = step,
		$products = context.find('.product')
	
	$products.find('.images').height('auto')
	$products.find('.name').height('auto')
	$products.find('.list_tags_prods').height('auto')

	$products.each(() => {
		//setHeight($products.slice(start, finish).find('.images, .thumb'))
		setHeight($products.slice(start, finish).find('.name'))
		setHeight($products.slice(start, finish).find('.list_tags_prods'))
		start = start + step
		finish = finish + step
	})
}



